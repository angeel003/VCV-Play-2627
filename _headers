# Reglas de caché estático para Cloudflare Pages

# Escudos e imágenes estáticas
/files/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# Hojas de estilo CSS y scripts JS modulares: siempre revalidar con ETag para cambios instantáneos
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Aplicación PWA y fuentes
/manifest.json
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Archivos HTML principales: siempre revalidar para tener la última versión
/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache
